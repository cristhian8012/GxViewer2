            <Source><![CDATA[// Valida estado de guia de proceso 99
// FSD603
FOR EACH ORDER Pgcod Itsuc Itmod Ittran Itnrel PfdId
    WHERE Pgcod = &Pgcod
    WHERE Itsuc = &itsuc
    WHERE Itmod = &itmod
    WHERE Ittran = &ittran
    WHERE Itnrel = &itnrel
    WHERE PfdId  = 0
    DEFINED BY PfdId
    &ctcta   = PfdCt01
    &ctsbop  = PfdSo01
    &ctmda   = PfdMo01
    &ctsuc   = PfdSu01
    &ctmod   = PfdSu05
    &cttope  = 0
    &ctpap   = 0
    &ctoper  = 0

    // Lee FSD011 para Validar scstat
    FOR EACH ORDER Pgcod Scmod Sctope Scmda Scpap Sccta Scoper Scsbop
        WHERE Pgcod  = &Pgcod
        WHERE Scmod  = &ctmod
        WHERE Sctope = &cttope
        WHERE Scmda  = &ctmda
        WHERE Scpap  = &ctpap
        WHERE Sccta  = &ctcta
        WHERE Scoper = &ctoper
        WHERE Scsbop = &ctsbop
        DEFINED BY Scsdo
        &Pscstat   = Scstat
        &Scstat    = Scstat
        &cScstat   = str(&Scstat,2)
        &FiltraSts = 'N'
        IF Scstat <> 0
           DO 'Filtra'
        ENDIF            
        If &FiltraSts = 'S'
           &Desc      = ' '
           do 'Busca_DescEst'
           &renglon1 = 'Error: Cuenta con estado'
           &renglon1 = concat(&renglon1,&cScstat,'  ')
           &renglon2 = &Desc
           &renglon3 = '                        '
           call(WLAGW07,&renglon1,&renglon2,&renglon3,&Coderr)
           &Cancel = 'S'
           &Coderr = 'S'
       EndIf
    ENDFOR

ENDFOR

//*************************************************************************
Sub 'Filtra'

&Ptpcod    = 99
&FiltraSts = 'N'
// FST098
FOR EACH
    WHERE Pgcod = &Pgcod
    WHERE Tpcod = &Ptpcod
    WHERE Tpcorr = &Pscstat
    DEFINED BY Tpdesc
    &FiltraSts = 'S'
ENDFOR

ENDSub
//**************************************************************************
Sub 'Busca_DescEst'
// FST026
FOR EACH
    WHERE Cecod = &Scstat
    &Desc       = Cenom
ENDFOR
EndSub
]]></Source>
